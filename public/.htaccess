<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route all /api/* requests to the PHP backend
  RewriteCond %{REQUEST_URI} ^/api/.*$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php/$1 [QSA,L]

  # 2. Serve actual existing files or directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all frontend routes to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Security & Compression Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
